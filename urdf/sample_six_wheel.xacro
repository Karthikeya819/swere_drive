            <origin xyz="0 0.0125 0" rpy="1.57 0 0"/>
        </collision>
    </link>
    <joint name="joint_link_wheel_holder_1_link_wheel_1" type="continuous">
        <origin rpy="0 0 0" xyz="0 0.025 -0.1"/>
        <axis rpy="0 0 0" xyz="0 -1 0"/>
        <limit effort="10000" velocity="1000"/>
        <joint_properties damping="1.0" friction="1.0"/>
        <child link="link_wheel_1"/>
        <parent link="link_wheel_holder_1"/>
    </joint>
