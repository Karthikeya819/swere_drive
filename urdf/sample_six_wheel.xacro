    <joint name="joint_link_link_base_wheel_holder_3" type="revolute">
        <origin rpy="0 0 0" xyz="0.2 0.175 0.15"/>
        <axis rpy="0 0 0" xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
        <dynamics damping="10.0" friction="0.5"/>
        <child link="link_wheel_holder_3"/>
        <parent link="link_base"/>
    </joint>
