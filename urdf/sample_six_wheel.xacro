    <!-- Plugins -->
    <gazebo>
        <plugin name="ackermann_drive" filename="libackerman_drive_plugin.so">
            <updateRate>20</updateRate>
            <commandTopic>cmd_vel</commandTopic>
            <odometryTopic>odom</odometryTopic>
            <odometryFrame>odom</odometryFrame>
            <robotBaseFrame>link_chassis</robotBaseFrame>
            <sixWheel>true</sixWheel>
            <wheelRadius>0.05</wheelRadius>
            <wheelSeperation>0.4</wheelSeperation>
            <wheelBase>0.4</wheelBase>
            <front_left_wheel_joint>joint_link_wheel_holder_6_link_wheel_6</front_left_wheel_joint>
            <front_right_wheel_joint>joint_link_wheel_holder_5_link_wheel_5</front_right_wheel_joint>
            <middle_left_wheel_joint>joint_link_wheel_holder_2_link_wheel_2</middle_left_wheel_joint>
            <middle_right_wheel_joint>joint_link_wheel_holder_1_link_wheel_1</middle_right_wheel_joint>
            <back_left_wheel_joint>joint_link_wheel_holder_4_link_wheel_4</back_left_wheel_joint>
            <back_right_wheel_joint>joint_link_wheel_holder_3_link_wheel_3</back_right_wheel_joint>
            <front_left_stepper_joint>joint_link_link_base_wheel_holder_6</front_left_stepper_joint>
            <front_right_stepper_joint>joint_link_link_base_wheel_holder_5</front_right_stepper_joint>
            <back_left_stepper_joint>joint_link_link_base_wheel_holder_4</back_left_stepper_joint>
            <back_right_stepper_joint>joint_link_link_base_wheel_holder_3</back_right_stepper_joint>
        </plugin>
    </gazebo>
