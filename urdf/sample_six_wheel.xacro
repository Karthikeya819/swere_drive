        </collision>
    </link>
    <joint name="joint_link_link_base_wheel_holder_2" type="fixed">
        <origin rpy="0 0 0" xyz="0 -0.175 0.15"/>
        <child link="link_wheel_holder_2"/>
        <parent link="link_base"/>
    </joint>
    <link name="link_wheel_holder_3">
        <pose>0 0 -0.025 0 0 0</pose>
