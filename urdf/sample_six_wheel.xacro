<?xml version="1.0" ?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <link name="link_base">
        <pose>0 0 0.25 0 0 0</pose>
        <inertial>
            <mass value="20"/>
            <origin xyz="0 0 0.25" rpy="0 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
        <visual name="link_base_visual">
            <geometry>
                <box size="0.6 0.4 0.2"/>
            </geometry>
            <origin xyz="0 0 0.25" rpy="0 0 0"/>
        </visual>
        <collision name="link_base_collision">
            <geometry>
                <box size="0.6 0.4 0.2"/>
            </geometry>
            <origin xyz="0 0 0.25" rpy="0 0 0"/>
        </collision>
    </link>
    <link name="link_wheel_holder_1">
        <pose>0 0 -0.025 0 0 0</pose>
        <inertial>
            <mass value="1"/>
            <origin xyz="0 0 -0.025" rpy="0 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
        <visual name="link_wheel_holder_1_visual">
            <geometry>
                <box size="0.05 0.05 0.05"/>
            </geometry>
            <origin xyz="0 0 -0.025" rpy="0 0 0"/>
        </visual>
        <collision name="llink_wheel_holder_1_collision">
            <geometry>
                <box size="0.05 0.05 0.05"/>
            </geometry>
            <origin xyz="0 0 -0.025" rpy="0 0 0"/>
        </collision>
    </link>
    <joint name="joint_link_link_base_wheel_holder_1" type="fixed">
        <origin rpy="0 0 0" xyz="0 0.175 0.15"/>
        <child link="link_wheel_holder_1"/>
        <parent link="link_base"/>
    </joint>
    <link name="link_wheel_holder_2">
        <pose>0 -0.025 -0.025 0 0 0</pose>
        <inertial>
            <mass value="1"/>
            <origin xyz="0 0 -0.025" rpy="0 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
