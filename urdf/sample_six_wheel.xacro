    <link name="link_wheel_1">
        <pose>0 0.0125 0 1.57 0 0</pose>
        <inertial>
            <mass value="1"/>
            <origin xyz="0 0.0125 0" rpy="1.57 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
        </inertial>
        <visual name="link_wheel_1_visual">
